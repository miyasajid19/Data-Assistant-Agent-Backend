# ---- LLM (MiniMax — OpenAI-compatible HTTP API) ----
# Get your key from https://MiniMax.io/
MINIMAX_API_KEY=your-MiniMax-api-key
MINIMAX_BASE_URL=https://api.MiniMax.chat/v1
MINIMAX_MODEL=MiniMax-M3

# ---- Server ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Agent behavior ----
# Max iterations of the tool-calling loop per user turn
AGENT_MAX_ITERATIONS=10
# Timeout for each pandas code execution (seconds)
CODE_EXEC_TIMEOUT=30

# ---- Persistence (LangGraph checkpointer) ----
# Default: a local SQLite file at backend/checkpoints.db. No setup, no
# extra dependencies — chat history survives backend restarts out of the box.
#
# Optional: set this to a Postgres URL (psycopg format) to share chat
# history across multiple backend processes / machines. Requires the
# PostgresSaver path; useful for horizontal scaling but NOT required for
# the contest demo.
# Example:
#   DATABASE_URL=postgresql://user:password@localhost:5432/data_assistant
DATABASE_URL=
